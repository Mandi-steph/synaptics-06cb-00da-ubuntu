+static BOOL __winfnc WTSRegisterSessionNotification(HANDLE hWnd, DWORD dwFlags) {
+    WIN_CLOBBER_NONVOL_REGS
+    (void)hWnd; (void)dwFlags;
+    return 1;
+}
+WINAPI(WTSRegisterSessionNotification)
